# CLI
abbr -a cat 'bat'
abbr -a .. 'cd ..'
abbr -a ls 'eza -hal --color=auto --icons=auto --group-directories-first --no-user --no-permissions'
abbr -a tree 'eza -Ta'
abbr -a find 'fd'
abbr -a cl 'clear'
abbr -a lg 'lazygit'
abbr -a du 'gdu'
abbr -a y 'yazi'

# ARCH
abbr -a cleanup 'sudo pacman -Rns (pacman -Qtdq)'

# Fish
abbr -a fishs 'source ~/.config/fish/config.fish'
abbr -a abbrs 'micro ~/.config/fish/abbr.fish'
